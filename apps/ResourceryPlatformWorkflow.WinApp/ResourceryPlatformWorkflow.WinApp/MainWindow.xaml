<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ResourceryPlatformWorkflow.WinApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Resourcery Desktop Recorder">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowDefinitions="Auto,*" RowSpacing="20">
        <StackPanel Spacing="6">
            <TextBlock Text="Smart Serve Live Recording" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Record webcam + microphone, save the file locally, and upload it to the transcription service." Opacity="0.75" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="20">
                <StackPanel Grid.Column="0" Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="ApiEndpointTextBox" Header="Transcription API endpoint" PlaceholderText="https://server/api/workflow/transcription/submit-to-wipo" LostFocus="ApiEndpointTextBox_LostFocus" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="RecordingFolderTextBox" Header="Save folder" IsReadOnly="True" PlaceholderText="Choose where recordings are saved" />
                            <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="BrowseFolderButton_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBox x:Name="TitleTextBox" Header="Recording title" PlaceholderText="Desk meeting" />
                        <TextBox x:Name="DescriptionTextBox" Header="Description" PlaceholderText="Recorded from Windows desktop app" />
                        <TextBox x:Name="LanguageTextBox" Header="Language" PlaceholderText="en" />
                        <TextBlock x:Name="SourceReferenceTextBlock" Text="Source reference: -" FontFamily="Consolas" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartRecordingButton" Content="Start Recording" Click="StartRecordingButton_Click" />
                        <Button x:Name="StopRecordingButton" Content="Stop Recording" Click="StopRecordingButton_Click" IsEnabled="False" />
                        <Button x:Name="UploadButton" Content="Upload Last Recording" Click="UploadButton_Click" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Status" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusTextBlock" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Last recording" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="RecordingFileTextBlock" TextWrapping="WrapWholeWords" FontFamily="Consolas" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="API response" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="ApiResponseTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="220" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Live camera preview" FontSize="18" FontWeight="SemiBold" />
                    <Border Height="620" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Image x:Name="CameraPreviewImage" Stretch="UniformToFill" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
