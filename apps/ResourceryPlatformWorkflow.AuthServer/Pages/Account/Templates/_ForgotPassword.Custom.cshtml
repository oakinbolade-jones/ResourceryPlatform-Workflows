@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model Volo.Abp.Account.Web.Pages.Account.ForgotPasswordModel
@inject IHtmlLocalizer<AccountResource> L
@inject IHtmlLocalizer<ResourceryPlatformWorkflow.Workflow.Localization.WorkflowResource> LW

<div class="rp-smartserve-page">
    <div class="rp-smartserve-card">
        <aside class="rp-smartserve-side">
            <div class="rp-smartserve-brand" aria-label="ECOWAS SmartServe logo">
                <a href="http://smartserve.ecowas.int">
                    <img src="/images/logo/ecw-smartserve-logo-no-text.png" alt="ECOWAS" />
                </a>
            </div>

            <h1 class="rp-smartserve-title">@L["ForgotPassword"]</h1>

            <p class="rp-smartserve-subtitle">
                @L["SendPasswordResetLink_Information"]
            </p>

            @* <p class="rp-smartserve-footer">
                @LW["ECOWASCopyright"]<br />
                @LW["ECOWAS"]
            </p> *@
        </aside>

        <section class="rp-smartserve-panel">
            <form method="post" class="rp-smartserve-form" id="forgotPasswordForm">
                <abp-validation-summary />
                <input asp-for="ReturnUrl" type="hidden" />
                <input asp-for="ReturnUrlHash" type="hidden" />

                <div class="rp-smartserve-field">
                    <div class="form-floating rp-smartserve-floating-field">
                        <input asp-for="Email" type="email" class="form-control rp-smartserve-input"
                               autocomplete="email" required placeholder="@LW["Account:EnterEmailAddress"]" />
                        <label asp-for="Email">@LW["Account:Email"]</label>
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="rp-smartserve-actions">
                    <button type="submit" class="btn btn-success rp-smartserve-submit">@L["Submit"]</button>
                </div>

                <div class="mt-4">
                    <a class="text-decoration-none" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl"
                       asp-route-returnUrlHash="@Model.ReturnUrlHash" style="color: #198754; font-weight: 600;">
                        <i class="fa fa-long-arrow-left me-1" aria-hidden="true"></i>@L["BackToLogin"]
                    </a>
                </div>
            </form>
        </section>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const popper = typeof window.rpAccountShowPopper === 'function' ? window.rpAccountShowPopper : null;
        const forgotPasswordForm = document.getElementById('forgotPasswordForm');
        if (!forgotPasswordForm) {
            return;
        }

        const emailField = forgotPasswordForm.querySelector('input[name="Email"]');
        forgotPasswordForm.addEventListener('submit', function (event) {
            if (!emailField || !emailField.value || !emailField.value.trim()) {
                event.preventDefault();
                if (emailField) {
                    emailField.focus();
                }
                if (popper) {
                    popper('Reset request failed. Email is required.', 'danger');
                }
                return;
            }

            if (emailField.validity && !emailField.validity.valid) {
                event.preventDefault();
                emailField.focus();
                if (popper) {
                    popper('Reset request failed. Please provide a valid email address.', 'warning');
                }
                return;
            }

            if (popper) {
                popper('Reset request validation passed. Sending reset link...', 'success');
            }
        });
    });
</script>
