@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model Volo.Abp.Account.Web.Pages.Account.RegisterModel
@inject IHtmlLocalizer<AccountResource> L
@inject IHtmlLocalizer<ResourceryPlatformWorkflow.Workflow.Localization.WorkflowResource> LW

<div class="rp-smartserve-page">
    <div class="rp-smartserve-card">
        <aside class="rp-smartserve-side">
            <div class="rp-smartserve-brand" aria-label="ECOWAS SmartServe logo">
                <img src="/images/logo/ecw-smartserve-logo-no-text.png" alt="ECOWAS" />
         </div>

            <h1 class="rp-smartserve-title">@L["Register"]</h1>

            <p class="rp-smartserve-subtitle">
                @L["AlreadyRegistered"]
                <a href="@Url.Page("./Login", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash })">@L["Login"]</a>
            </p>

            <p class="rp-smartserve-footer">
                @LW["ECOWASCopyright"]<br />
                @LW["ECOWAS"]
            </p>
        </aside>

        <section class="rp-smartserve-panel">
            @if (!Model.IsExternalLogin && Model.VisibleExternalProviders.Any())
            {
                <div class="rp-smartserve-external">
                    <form asp-page="./Login"
                          asp-page-handler="ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          asp-route-returnUrlHash="@Model.ReturnUrlHash"
                          method="post"
                          class="rp-smartserve-provider-form">
                        @foreach (var provider in Model.VisibleExternalProviders)
                        {
                            if (provider.AuthenticationScheme == "Microsoft")
                            {
                                <button type="submit"
                                        class="btn btn-outline-secondary rp-smartserve-provider-btn"
                                        name="provider"
                                        value="@provider.AuthenticationScheme"
                                        title="@L["RegisterUsingYourProviderAccount", provider.DisplayName]">
                                    <img src="/images/logo/ecowas-logo.png" alt="ECOWAS Commission" />
                                    @LW["Account:RegisterWithECOWASMail"]
                                </button>
                                <div class="rp-smartserve-divider">
                                    <span>@LW["ECOWASAccountOR"]</span>
                                </div>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-outline-secondary rp-smartserve-provider-btn"
                                        name="provider"
                                        value="@provider.AuthenticationScheme"
                                        title="@L["RegisterUsingYourProviderAccount", provider.DisplayName]">@provider.DisplayName</button>
                            }
                        }
                    </form>
                </div>
            }

            @if (Model.EnableLocalRegister || Model.IsExternalLogin)
            {
                <form method="post" class="rp-smartserve-form">
                    <abp-validation-summary />

                    <div class="rp-smartserve-field">
                        <div class="form-floating rp-smartserve-floating-field">
                            <input asp-for="Input.UserName"
                                   class="form-control rp-smartserve-input"
                                   autocomplete="off"
                                   placeholder="@LW["Account:EnterUsername"]" />
                            <label asp-for="Input.UserName">@LW["Account:Username"]</label>
                        </div>
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>

                    <div class="rp-smartserve-field">
                        <div class="form-floating rp-smartserve-floating-field">
                            <input asp-for="Input.EmailAddress"
                                   class="form-control rp-smartserve-input"
                                   autocomplete="off"
                                   placeholder="@LW["Account:EnterEmailAddress"]" />
                            <label asp-for="Input.EmailAddress">@LW["Account:Email"]</label>
                        </div>
                        <span asp-validation-for="Input.EmailAddress" class="text-danger"></span>
                    </div>

                    @if (!Model.IsExternalLogin && Model.EnableLocalRegister)
                    {
                        <div class="rp-smartserve-field">
                            <div class="form-floating rp-smartserve-password-wrap">
                                <input asp-for="Input.Password"
                                       type="password"
                                       class="form-control rp-smartserve-input rp-smartserve-password-input"
                                       autocomplete="new-password"
                                       placeholder="@LW["Account:EnterPassword"]" />
                                <label asp-for="Input.Password">@LW["Account:Password"]</label>
                                <button class="btn rp-smartserve-password-toggle password-visibility-button"
                                        type="button"
                                        aria-label="Show password"
                                        title="Show password">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                    }

                    <div class="rp-smartserve-actions">
                        <button type="submit" class="btn btn-primary rp-smartserve-submit">@L["Register"]</button>
                    </div>
                </form>
            }
        </section>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.password-visibility-button').forEach(function (button) {
            const input = button.closest('.input-group')?.querySelector('input');
            const icon = button.querySelector('i');

            if (!input || !icon) {
                return;
            }

            button.addEventListener('click', function () {
                const isPasswordHidden = input.type === 'password';
                input.type = isPasswordHidden ? 'text' : 'password';
                const shouldShowPassword = !isPasswordHidden;
                icon.classList.toggle('fa-eye', !shouldShowPassword);
                icon.classList.toggle('fa-eye-slash', shouldShowPassword);
                button.setAttribute('aria-label', shouldShowPassword ? 'Hide password' : 'Show password');
                button.setAttribute('title', shouldShowPassword ? 'Hide password' : 'Show password');
                button.setAttribute('aria-pressed', String(shouldShowPassword));
            });
        });
    });
</script>
