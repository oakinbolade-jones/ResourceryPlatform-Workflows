@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Settings
@using Volo.Abp.Settings
@model Volo.Abp.Account.Web.Pages.Account.LoginModel
@inject IHtmlLocalizer<AccountResource> L
@inject IHtmlLocalizer<ResourceryPlatformWorkflow.Workflow.Localization.WorkflowResource> LW
@inject Volo.Abp.Settings.ISettingProvider SettingProvider

@{
    var registerUrl = Url.Page("./Register", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash });
    var forgotPasswordUrl = Url.Page("./ForgotPassword", new
    {
        returnUrl = Model.ReturnUrl,
        returnUrlHash = Model.ReturnUrlHash
    });
    var signIn = LW["Account:SignIn"];
    var signInText = LW["Account:SignInText"];
    var signInCreateText = LW["Account:SignInCreateText"];
    var newUserText = LW["Account:NewUser?"];
    var createAccountText = LW["Account:CreateAccount"];
    var loginWithEcowasMailText = LW["Account:LoginWithECOWASMail"];
    var ecowasCopyrightText = LW["ECOWASCopyright"];
    var ecowasText = LW["ECOWAS"];
    var invalidLoginRequestText = L["InvalidLoginRequest"];
    var noLoginSchemesText = L["ThereAreNoLoginSchemesConfiguredForThisClient"];
    var ecowasAccountOrText = LW["ECOWASAccountOR"];
    var usernameOrEmailLabelText = LW["Account:UsernameOrEmail"];
    var passwordLabelText = LW["Account:Password"];
    var usernamePlaceholderText = LW["Account:EnterUsernameOrEmail"];
    var passwordPlaceholderText = LW["Account:EnterAccountPassword"];
    var forgotPasswordText = L["ForgotPassword"];
    var loginText = L["Login"];
    var cancelText = L["Cancel"];
}

<div class="rp-smartserve-page rp-smartserve-page-login">
    <div class="rp-smartserve-card rp-smartserve-card-login">
        <aside class="rp-smartserve-side">
            <div class="rp-smartserve-brand" aria-label="ECOWAS SmartServe logo">
                <a href="http://smartserve.ecowas.int">
                    <img src="/images/logo/ecw-smartserve-logo-no-text.png" alt="ECOWAS" />
                </a>
            </div>

            <h1 class="rp-smartserve-title">@signIn</h1>

            <p class="rp-smartserve-login-copy">@signInText</p>

          

            @* <p class="rp-smartserve-footer">
                @ecowasCopyrightText<br />
                @ecowasText
            </p> *@
        </aside>

        <section class="rp-smartserve-panel rp-smartserve-panel-login">

         
            @if (Model.VisibleExternalProviders.Any())
            {
                <div class="rp-smartserve-external">
                    <form asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl"
                          asp-route-returnUrlHash="@Model.ReturnUrlHash" method="post" class="rp-smartserve-provider-form">
                        @foreach (var provider in Model.VisibleExternalProviders)
                        {
                            if (provider.AuthenticationScheme == "Microsoft")
                            {
                                var microsoftProviderTitle = L["LogInUsingYourProviderAccount", provider.AuthenticationScheme];
                                <button type="submit" class="btn rp-smartserve-provider-btn" name="provider"
                                        value="@provider.AuthenticationScheme" title="@microsoftProviderTitle">
                                    <img src="/images/logo/ecw-smartserve-logo-no-text.png" alt="ECOWAS Commission" />
                                    @loginWithEcowasMailText
                                </button>
                            }
                            else
                            {
                                var providerTitle = L["LogInUsingYourProviderAccount", provider.DisplayName];
                                <button type="submit" class="btn rp-smartserve-provider-btn" name="provider"
                                        value="@provider.AuthenticationScheme" title="@providerTitle">
                                    @provider.DisplayName
                                </button>
                            }
                        }
                    </form>
                </div>
            }

            @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
            {
                <div class="alert alert-warning">
                    <strong>@invalidLoginRequestText</strong>
                    @noLoginSchemesText
                </div>
            }

            @if (Model.EnableLocalLogin)
            {
                @if (Model.VisibleExternalProviders.Any())
                {
                    <div class="rp-smartserve-divider rp-smartserve-login-divider">
                        <span>@ecowasAccountOrText</span>
                    </div>
                }

                <form method="post" class="rp-smartserve-form" id="loginForm">
                    <abp-validation-summary />

                    <div class="rp-smartserve-field mb-4">
                        <div class="form-floating rp-smartserve-floating-field">
                            <input asp-for="LoginInput.UserNameOrEmailAddress" class="form-control rp-smartserve-input"
                                   required autocomplete="username" placeholder="@usernamePlaceholderText" />
                            <label asp-for="LoginInput.UserNameOrEmailAddress">@usernameOrEmailLabelText</label>
                        </div>
                        <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="text-danger"></span>
                    </div>

                    <div class="rp-smartserve-field mb-1">
                        <div class="rp-smartserve-password-wrap">
                            <div class="form-floating rp-smartserve-floating-field">
                                <input type="password" class="form-control rp-smartserve-input"
                                       autocomplete="current-password"
                                       maxlength="@(Volo.Abp.Identity.IdentityUserConsts.MaxPasswordLength)" required
                                       asp-for="LoginInput.Password" placeholder="@passwordPlaceholderText" />
                                <label asp-for="LoginInput.Password">@passwordLabelText</label>
                            </div>
                            <button class="btn rp-smartserve-password-toggle password-visibility-button" type="button"
                                    id="PasswordVisibilityButton" aria-label="Show password" title="Show password"
                                    aria-pressed="false">
                                <i class="fa fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="LoginInput.Password" class="text-danger"></span>
                    </div>

                    @* <div class="rp-smartserve-check-row">
                        <abp-input asp-for="LoginInput.RememberMe" class="mb-0" />
                    </div> *@

                    <div class="rp-smartserve-field-action rp-smartserve-login-forgot">
                        <a href="@forgotPasswordUrl">@forgotPasswordText</a>
                    </div>
                    <div class="rp-smartserve-field-action mt-3">
                        <p class="rp-smartserve-subtitle">
                            @newUserText
                        </p>
                    </div>
                    <div class="rp-smartserve-actions rp-smartserve-login-actions">
                        @if (await SettingProvider.IsTrueAsync(AccountSettingNames.IsSelfRegistrationEnabled))
                        {

                        }
                        @if (Model.ShowCancelButton)
                        {
                            <abp-button type="submit" formnovalidate="formnovalidate" name="Action" value="Cancel"
                                        class="btn rp-smartserve-cancel">@cancelText</abp-button>
                        }
                        <a href="@registerUrl">@createAccountText</a>
                        <abp-button type="submit" name="Action" value="Login"
                                    class="btn btn-success rp-smartserve-submit">@loginText</abp-button>
                    </div>
                </form>
            }
        </section>
    </div>
</div>

 
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const popper = typeof window.rpAccountShowPopper === 'function' ? window.rpAccountShowPopper : null;
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            const usernameField = loginForm.querySelector('input[name="LoginInput.UserNameOrEmailAddress"]');
            const passwordField = loginForm.querySelector('input[name="LoginInput.Password"]');

            loginForm.addEventListener('submit', function (event) {
                if (!usernameField || !usernameField.value || !usernameField.value.trim()) {
                    event.preventDefault();
                    if (usernameField) {
                        usernameField.focus();
                    }
                    if (popper) {
                        popper('Login failed. Username or email is required.', 'danger');
                    }
                    return;
                }

                if (!passwordField || !passwordField.value || !passwordField.value.trim()) {
                    event.preventDefault();
                    if (passwordField) {
                        passwordField.focus();
                    }
                    if (popper) {
                        popper('Login failed. Password is required.', 'danger');
                    }
                    return;
                }

                if (popper) {
                    popper('Login validation passed. Signing in...', 'success');
                }
            });
        }

        document.querySelectorAll('.password-visibility-button').forEach(function (button) {
            const container = button.closest('.rp-smartserve-password-wrap') || button.closest('.input-group') || button.parentElement;
            const input = container ? container.querySelector('input[type="password"], input[type="text"]') : null;
            const icon = button.querySelector('i');

            if (!input || !icon) {
                return;
            }

            button.addEventListener('click', function () {
                const isPasswordHidden = input.type === 'password';
                input.type = isPasswordHidden ? 'text' : 'password';
                const isShowingPassword = !isPasswordHidden;
                icon.classList.toggle('fa-eye', !isShowingPassword);
                icon.classList.toggle('fa-eye-slash', isShowingPassword);
                button.setAttribute('aria-label', isShowingPassword ? 'Hide password' : 'Show password');
                button.setAttribute('title', isShowingPassword ? 'Hide password' : 'Show password');
                button.setAttribute('aria-pressed', String(isShowingPassword));
            });
        });
    });
</script>
