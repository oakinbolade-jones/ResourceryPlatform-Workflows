@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Settings
@using Volo.Abp.Settings
@model Volo.Abp.Account.Web.Pages.Account.LoginModel
@inject IHtmlLocalizer<AccountResource> L
@inject IHtmlLocalizer<ResourceryPlatformWorkflow.Workflow.Localization.WorkflowResource> LW
@inject Volo.Abp.Settings.ISettingProvider SettingProvider

@{
    var registerUrl = Url.Page("./Register", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash });
    var forgotPasswordUrl = Url.Page("./ForgotPassword", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash });
    var getStartedText = LW["Account:GetStarted"];
    var newUserText = LW["Account:NewUser?"];
    var createAccountText = LW["Account:CreateAccount"];
    var loginWithEcowasMailText = LW["Account:LoginWithECOWASMail"];
    var ecowasCopyrightText = LW["ECOWASCopyright"];
    var ecowasText = LW["ECOWAS"];
    var invalidLoginRequestText = L["InvalidLoginRequest"];
    var noLoginSchemesText = L["ThereAreNoLoginSchemesConfiguredForThisClient"];
    var ecowasAccountOrText = LW["ECOWASAccountOR"];
    var usernameOrEmailLabelText = LW["Account:UsernameOrEmail"];
    var passwordLabelText = LW["Account:Password"];
    var usernamePlaceholderText = LW["Account:EnterUsernameOrEmail"];
    var passwordPlaceholderText = LW["Account:EnterAccountPassword"];
    var forgotPasswordText = L["ForgotPassword"];
    var loginText = L["Login"];
    var cancelText = L["Cancel"];
}

<div class="lpx-content-container">
    <div class="lpx-content">
        <div class="container-fluid mt-3 mb-5">
            <div class="row justify-content-center">
                <div class="col-12 col-md-11 col-lg-10 col-xl-8">
                    <div class="row g-0 shadow-sm border border-success rounded-1 overflow-hidden w-100 justify-content-center">
                        <div class="col-12 col-md-5 bg-white text-dark d-flex flex-column justify-content-stretch p-4 p-lg-5">
                            <h2 class="h3 mb-3 fs-2 fw-normal title">@getStartedText</h2>

                            @if (await SettingProvider.IsTrueAsync(AccountSettingNames.IsSelfRegistrationEnabled))
                            {
                                <p class="fw-normal fs-6 text-body-secondary">
                                    @newUserText
                                    <a href="@registerUrl"
                                       class="text-decoration-none text-emphasis">@createAccountText</a>
                                </p>
                            }

                            <p class="eco-desktop d-none d-xl-block mt-auto mb-0 small opacity-75">
                                <hr />
                                @ecowasCopyrightText <br />
                                @ecowasText
                            </p>
                        </div>

                        <div class="col-12 col-md-7 bg-white p-4 p-lg-5">
                            <div class="mb-4">
                                @if (Model.VisibleExternalProviders.Any())
                                {
                                    <div class="mt-4">
                                        <div class="w-100 d-flex justify-content-start">
                                            <form asp-page="./Login"
                                                  asp-page-handler="ExternalLogin"
                                                  asp-route-returnUrl="@Model.ReturnUrl"
                                                  asp-route-returnUrlHash="@Model.ReturnUrlHash"
                                                  method="post"
                                                  class="d-flex flex-wrap gap-2 p-0">
                                                @foreach (var provider in Model.VisibleExternalProviders)
                                                {
                                                    if (provider.AuthenticationScheme == "Microsoft")
                                                    {
                                                        var microsoftProviderTitle = L["LogInUsingYourProviderAccount", provider.AuthenticationScheme];
                                                        <button type="submit"
                                                                class="btn btn-outline-success rounded-1 fw-semibold"
                                                                name="provider"
                                                                value="@provider.AuthenticationScheme"
                                                        title="@microsoftProviderTitle">
                                                            <img src="/images/logo/ecowas-logo.png"
                                                                 alt="ECOWAS Commission"
                                                                 class="d-inline-block align-text-center"
                                                                         style="max-width: 35px;" /> @loginWithEcowasMailText
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        var providerTitle = L["LogInUsingYourProviderAccount", provider.DisplayName];
                                                        <button type="submit"
                                                                class="btn btn-outline-secondary rounded-1"
                                                                name="provider"
                                                                value="@provider.AuthenticationScheme"
                                                            title="@providerTitle">@provider.DisplayName</button>
                                                    }
                                                }
                                            </form>
                                        </div>
                                    </div>
                                }

                                @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
                                {
                                    <div class="alert alert-warning mt-3">
                                        <strong>@invalidLoginRequestText</strong>
                                        @noLoginSchemesText
                                    </div>
                                }
                            </div>

                            @if (Model.EnableLocalLogin)
                            {
                                <div class="mb-3">
                                    <p class="fw-semibold fs-4">@ecowasAccountOrText</p>
                                    <hr />
                                </div>

                                <form method="post" class="mt-4" id="loginForm">
                                    <abp-validation-summary />

                                    <div class="mb-3">
                                        <label asp-for="LoginInput.UserNameOrEmailAddress" class="form-label">@usernameOrEmailLabelText</label>
                                        <input asp-for="LoginInput.UserNameOrEmailAddress"
                                               class="form-control border border-success rounded-0 p-2"
                                               autocomplete="off"
                                                 placeholder="@usernamePlaceholderText" />
                                        <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="LoginInput.Password" class="form-label">@passwordLabelText</label>
                                        <div class="input-group">
                                            <input type="password"
                                                   class="form-control border border-success rounded-0 p-2"
                                                   autocomplete="new-password"
                                                   maxlength="@(Volo.Abp.Identity.IdentityUserConsts.MaxPasswordLength)"
                                                   asp-for="LoginInput.Password"
                                                   placeholder="@passwordPlaceholderText" />
                                            <button class="btn btn-outline-success rounded-1" type="button" id="PasswordVisibilityButton">
                                                <i class="fa fa-eye-slash text-dark" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="LoginInput.Password" class="text-danger"></span>
                                    </div>

                                    <div class="row align-items-center mb-3">
                                        <div class="col">
                                            <abp-input asp-for="LoginInput.RememberMe" class="mb-0 border border-success" />
                                        </div>
                                        <div class="col text-end">
                                            <a class="text-success semi-bold"
                                               href="@forgotPasswordUrl">@forgotPasswordText</a>
                                        </div>
                                    </div>

                                    <div class="d-grid gap-0">
                                        <abp-button type="submit"
                                                    name="Action"
                                                    value="Login"
                                                    class="btn btn-lg btn-success mt-3 rounded-0">@loginText</abp-button>
                                        @if (Model.ShowCancelButton)
                                        {
                                            <abp-button type="submit"
                                                        formnovalidate="formnovalidate"
                                                        name="Action"
                                                        value="Cancel"
                                                        class="btn btn-lg btn-success rounded-0 mt-3">@cancelText</abp-button>
                                        }
                                    </div>
                                    
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
