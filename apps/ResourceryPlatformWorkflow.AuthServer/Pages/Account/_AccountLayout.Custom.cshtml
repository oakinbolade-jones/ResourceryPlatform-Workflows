@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Globalization
@inject Volo.Abp.Localization.ILanguageProvider LanguageProvider

@{
    var languages = await LanguageProvider.GetLanguagesAsync();
    var currentLanguage = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}

<link rel="stylesheet" href="~/libs/bootstrap/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/styles.css" />
<link rel="stylesheet" href="~/libs/fortawesome/fontawesome-free/css/all.css" />
<script src="~/libs/bootstrap/js/bootstrap.bundle.js"></script>

<nav class="navbar navbar-expand navbar-light bg-light border-bottom mb-3">
	<div class="container-fluid justify-content-end">
		@if (languages != null && languages.Count > 0)
		{
			<div class="dropdown">
				<button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
					@(languages.FirstOrDefault(x => x.CultureName == currentLanguage)?.DisplayName ?? currentLanguage)
				</button>
				<ul class="dropdown-menu dropdown-menu-end">
					@foreach (var language in languages)
					{
						<li>
							<a class="dropdown-item" href="~/Abp/Languages/Switch?culture=@language.CultureName&uiCulture=@language.UiCultureName&returnUrl=@returnUrl">
								@language.DisplayName
							</a>
						</li>
					}
				</ul>
			</div>
		}
	</div>
</nav>

@{
	IgnoreSection("scripts");
}
@RenderBody()
