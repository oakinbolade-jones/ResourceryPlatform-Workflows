{ "ConnectionStrings": {
           "redis": "localhost:6379"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "administration": {
                "ClusterId": "administration",
                "Match": {
                    "Path": "{**catch-all}"
                }
            },
            "identity": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/api/identity/{*any}"
                }
            },
            "account": {
                "ClusterId": "account",
                "Match": {
                    "Path": "/api/account/{*any}"
                }
            },
            "saas": {
                "ClusterId": "saas",
                "Match": {
                    "Path": "/api/multi-tenancy/{*any}"
                }
            },
            "saas-feature-management": {
                "ClusterId": "saas",
                "Match": {
                    "Path": "/api/feature-management/{*any}"
                }
            },
            "workflow": {
                "ClusterId": "workflow",
                "Match": {
                    "Path": "/api/workflow/{*any}"
                }
            }
        },
        "Clusters": {
            "administration": {
                "Destinations": {
                    "administration": {
                        "Address": "http://localhost:7001"
                    }
                }
            },
            "identity": {
                "Destinations": {
                    "identity": {
                        "Address": "http://localhost:7002"
                    }
                }
            },
            "account": {
                "Destinations": {
                    "account": {
                        "Address": "http://localhost:7002"
                    }
                }
            },
            "saas": {
                "Destinations": {
                    "saas": {
                        "Address": "http://localhost:7003"
                    }
                }
            },
            "workflow": {
                "Destinations": {
                    "workflow": {
                        "Address": "http://localhost:7004"
                    }
                }
            }
        }
    },
    "App": {
        "CorsOrigins": "http://smartserve.ecowas.int,http://localhost:7001,http://localhost:7002,http://localhost:7003,http://localhost:7004,http://api.smartserve.ecowas.int,http://auth.smartserve.ecowas.int"
    }
    ,"Redis": {
        "Configuration": "localhost:6379"
    }
}
